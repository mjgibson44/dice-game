{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dice-game",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The built client (npm run build). Unknown paths like /room/ABCD get index.html.
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Cloudflare creates the DNS record and certificate for this automatically (mjgibson.com is on this account).
  "routes": [{ "pattern": "dice.mjgibson.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
